/* ===== 基础变量定义 ===== */
:root
  --radius-large: 1.25rem
  --content-delay: 150ms

/* ===== Dusty Lily × French Rococo · 雾粉百合 ===== */
/* --rose-pink carries the dusty main swatch; --primary is the accessible
   interactive text color. Keep the original token names for shared consumers. */
:root
  --rose-petal: #F2EDEC
  --rose-pink: #B7818A
  --rose-gold: #B8A18E
  --text-primary: #453A3E
  --text-secondary: #67595F
  --text-muted: #706167
  --on-primary: #FAF7F5
  --surface-border: unquote("color-mix(in srgb, var(--text-primary) 13%, transparent)")
  --surface-shadow: 0 4px 20px rgba(69, 58, 62, 0.045), 0 1px 3px rgba(69, 58, 62, 0.035)
  --panel-bg: rgba(250, 247, 245, 0.96)
  --floral-opacity: 0.32

:root.dark
  --rose-petal: #3C3238
  --rose-pink: #C0959E
  --rose-gold: #B8A18E
  --text-primary: #EDE4E4
  --text-secondary: #D0C3C7
  --text-muted: #B8A9AF
  --on-primary: #242125
  --surface-border: unquote("color-mix(in srgb, var(--text-primary) 14%, transparent)")
  --surface-shadow: 0 4px 20px rgba(17, 15, 18, 0.15), 0 1px 3px rgba(17, 15, 18, 0.1)
  --panel-bg: rgba(52, 46, 52, 0.96)
  --floral-opacity: 0.10

/* ===== 主题相关变量 ===== */
:root
  --primary: unquote("oklch(from #86616A l c calc(h + var(--hue) - 355))")
  --page-bg: #F5EFE9
  --card-bg: #FAF7F5
  --card-bg-transparent: unquote("rgb(250 247 245 / var(--card-transparent-opacity, 0.6))")
  
  --btn-content: var(--text-secondary)
  --btn-regular-bg: #F0EBE8
  --btn-regular-bg-hover: #EAE3DF
  --btn-regular-bg-active: #E5DDDA
  
  --btn-plain-bg-hover: var(--btn-regular-bg)
  --btn-plain-bg-active: var(--btn-regular-bg)
  
  --btn-card-bg-hover: #F5F0ED
  --btn-card-bg-active: var(--btn-regular-bg)
  
  --enter-btn-bg: var(--btn-regular-bg)
  --enter-btn-bg-hover: var(--btn-regular-bg-hover)
  --enter-btn-bg-active: var(--btn-regular-bg-active)
  
  --deep-text: var(--text-primary)
  --title-active: var(--primary)
  
  --line-divider: unquote("color-mix(in srgb, var(--text-primary) 10%, transparent)")
  --line-color: var(--surface-border)
  --meta-divider: var(--surface-border)
  --content-meta: var(--text-secondary)
  
  --inline-code-bg: var(--btn-regular-bg)
  --inline-code-color: var(--primary)
  --muted: #EAE4E0
  --selection-bg: var(--rose-petal)
  --codeblock-bg: #F6F2EF
  --codeblock-topbar-bg: #EAE3DF
  
  --license-block-bg: var(--btn-regular-bg)
  
  --link-underline: var(--rose-pink)
  --link-hover: var(--primary)
  --link-active: var(--text-primary)
  
  --float-panel-bg: var(--card-bg)
  
  --scrollbar-bg-light: rgba(0, 0, 0, 0.4)
  --scrollbar-bg-hover-light: rgba(0, 0, 0, 0.5)
  --scrollbar-bg-active-light: rgba(0, 0, 0, 0.6)
  
  --scrollbar-bg-dark: rgba(255, 255, 255, 0.4)
  --scrollbar-bg-hover-dark: rgba(255, 255, 255, 0.5)
  --scrollbar-bg-active-dark: rgba(255, 255, 255, 0.6)
  
  --scrollbar-bg: var(--scrollbar-bg-light)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-light)
  --scrollbar-bg-active: var(--scrollbar-bg-active-light)
  
  --display-light-icon: 1
  --display-dark-icon: 0
  
  --admonitions-color-tip: oklch(0.7 0.14 180)
  --admonitions-color-note: oklch(0.7 0.14 250)
  --admonitions-color-important: oklch(0.7 0.14 310)
  --admonitions-color-warning: oklch(0.7 0.14 60)
  --admonitions-color-caution: oklch(0.6 0.2 25)
  
  /* TOC相关变量 */
  --toc-badge-bg: var(--btn-regular-bg)
  --toc-btn-hover: var(--btn-regular-bg-hover)
  --toc-btn-active: var(--btn-regular-bg-active)
  --toc-indicator-bg: var(--btn-regular-bg)
  --toc-width: calc((100vw - var(--page-width)) / 2 - 1rem)
  --toc-item-active: var(--primary)

  /* Live2D 消息框变量 */
  --l2d-msg-bg: var(--primary)

  /* 主题色选择条渐变 */
  --color-selection-bar: linear-gradient(to right, oklch(0.80 0.10 0), oklch(0.80 0.10 30), oklch(0.80 0.10 60), oklch(0.80 0.10 90), oklch(0.80 0.10 120), oklch(0.80 0.10 150), oklch(0.80 0.10 180), oklch(0.80 0.10 210), oklch(0.80 0.10 240), oklch(0.80 0.10 270), oklch(0.80 0.10 300), oklch(0.80 0.10 330), oklch(0.80 0.10 360))

/* 卡片风格跟随主题色相 */
:root:not(.dark) body.card-follow-theme-hue
  --card-bg: unquote("color-mix(in oklch, #FAF7F5 98%, var(--primary))")

/* 暗色主题变量 */
:root.dark
  --primary: unquote("oklch(from #C0959E l c calc(h + var(--hue) - 355))")
  --deep-text: var(--on-primary)
  --page-bg: #222025
  --card-bg: #342E34
  --card-bg-transparent: unquote("rgb(52 46 52 / var(--card-transparent-opacity, 0.6))")

  /* 导航栏玻璃高光与发丝线（暗色） */
  --navbar-glass-highlight: rgba(237, 228, 228, 0.06)
  --navbar-glass-hairline: var(--surface-border)

  --btn-content: var(--text-secondary)
  --btn-regular-bg: #3A343A
  --btn-regular-bg-hover: #403940
  --btn-regular-bg-active: #463D44
  
  --btn-plain-bg-hover: #373137
  --btn-plain-bg-active: #3A343A
  
  --btn-card-bg-hover: #353035
  --btn-card-bg-active: #3A343A
  
  --line-divider: unquote("color-mix(in srgb, var(--text-primary) 10%, transparent)")
  --line-color: var(--surface-border)
  --meta-divider: var(--surface-border)
  --content-meta: var(--text-secondary)
  
  --muted: #3A343A
  --selection-bg: var(--rose-petal)
  --codeblock-bg: #252126
  --codeblock-topbar-bg: #2B252B
  
  --license-block-bg: var(--codeblock-bg)
  
  --link-underline: var(--rose-pink)
  --link-hover: var(--primary)
  --link-active: var(--text-primary)
  
  --float-panel-bg: var(--card-bg)
  
  --scrollbar-bg: var(--scrollbar-bg-dark)
  --scrollbar-bg-hover: var(--scrollbar-bg-hover-dark)
  --scrollbar-bg-active: var(--scrollbar-bg-active-dark)
  
  --display-light-icon: 0
  --display-dark-icon: 1
  
  --admonitions-color-tip: oklch(0.75 0.14 180)
  --admonitions-color-note: oklch(0.75 0.14 250)
  --admonitions-color-important: oklch(0.75 0.14 310)
  --admonitions-color-warning: oklch(0.75 0.14 60)
  --admonitions-color-caution: oklch(0.65 0.2 25)
  
  /* TOC相关变量 - 暗色主题 */
  --toc-badge-bg: var(--btn-regular-bg)
  --toc-btn-hover: var(--btn-regular-bg-hover)
  --toc-btn-active: var(--btn-regular-bg-active)
  --toc-indicator-bg: var(--btn-regular-bg)
  --toc-item-active: var(--primary)

  /* Live2D 消息框变量 - 暗色主题 */
  --l2d-msg-bg: var(--btn-regular-bg)

  /* 主题色选择条渐变 - 暗色主题 */
  --color-selection-bar: linear-gradient(to right, oklch(0.70 0.10 0), oklch(0.70 0.10 30), oklch(0.70 0.10 60), oklch(0.70 0.10 90), oklch(0.70 0.10 120), oklch(0.70 0.10 150), oklch(0.70 0.10 180), oklch(0.70 0.10 210), oklch(0.70 0.10 240), oklch(0.70 0.10 270), oklch(0.70 0.10 300), oklch(0.70 0.10 330), oklch(0.70 0.10 360))

/* ===== 响应式断点变量 ===== */
:root
  /* 断点定义 */
  --breakpoint-xs: 320px
  --breakpoint-sm: 480px
  --breakpoint-md: 768px
  --breakpoint-lg: 1024px
  --breakpoint-xl: 1280px
  --breakpoint-2xl: 1536px
  
  /* 容器宽度 */
  --container-xs: 100%
  --container-sm: 100%
  --container-md: 100%
  --container-lg: 1024px
  --container-xl: 1280px
  --container-2xl: 1536px

/* ===== 动画变量 ===== */
:root
  /* 缓动函数 */
  --ease-standard: cubic-bezier(0.4, 0, 0.2, 1)
  --ease-decelerate: cubic-bezier(0.25, 0.46, 0.45, 0.94)
  --ease-accelerate: cubic-bezier(0.55, 0.055, 0.675, 0.19)
  --ease-sharp: cubic-bezier(0.4, 0, 0.6, 1)
  
  /* 动画时长 */
  --duration-fast: 100ms
  --duration-normal: 150ms
  --duration-medium: 200ms
  --duration-slow: 250ms
  --duration-slower: 300ms
  
  /* 动画延迟 */
  --delay-none: 0ms
  --delay-short: 30ms
  --delay-medium: 60ms
  --delay-long: 90ms
  --delay-longer: 120ms

/* ===== 间距变量 ===== */
:root
  /* 基础间距 */
  --spacing-xs: 0.25rem    /* 4px */
  --spacing-sm: 0.5rem     /* 8px */
  --spacing-md: 0.75rem    /* 12px */
  --spacing-lg: 1rem       /* 16px */
  --spacing-xl: 1.25rem    /* 20px */
  --spacing-2xl: 1.5rem    /* 24px */
  --spacing-3xl: 2rem      /* 32px */
  --spacing-4xl: 2.5rem    /* 40px */
  --spacing-5xl: 3rem      /* 48px */
  
  /* 组件间距 */
  --widget-gap-mobile: var(--spacing-md)
  --widget-gap-tablet: var(--spacing-lg)
  --widget-gap-desktop: var(--spacing-xl)
  
  /* 侧边栏宽度 */
  --sidebar-width-mobile: 100%
  --sidebar-width-tablet: 280px
  --sidebar-width-desktop: 320px

/* ===== 阴影变量 ===== */
:root
  /* 基础阴影 */
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.05)
  --shadow-md: 0 4px 6px rgba(0, 0, 0, 0.1)
  --shadow-lg: 0 10px 15px rgba(0, 0, 0, 0.1)
  --shadow-xl: 0 20px 25px rgba(0, 0, 0, 0.1)
  --shadow-2xl: 0 25px 50px rgba(0, 0, 0, 0.25)
  
  /* 特殊阴影 */
  --shadow-navbar: 0 4px 16px rgba(0, 0, 0, 0.1)
  --shadow-navbar-dark: 0 4px 16px rgba(0, 0, 0, 0.2)
  --shadow-button: 0 4px 12px rgba(0, 0, 0, 0.15)
  --shadow-button-dark: 0 4px 12px rgba(255, 255, 255, 0.1)

  /* 导航栏玻璃高光与发丝线（明色） */
  --navbar-glass-highlight: rgba(250, 247, 245, 0.3)
  --navbar-glass-hairline: var(--surface-border)

/* ===== 边框半径变量 ===== */
:root
  --radius-sm: 0.25rem     /* 4px */
  --radius-md: 0.375rem    /* 6px */
  --radius-lg: 0.5rem      /* 8px */
  --radius-xl: 0.75rem     /* 12px */
  --radius-2xl: 1rem       /* 16px */
  --radius-3xl: 1.5rem     /* 24px */
  --radius-full: 9999px

/* ===== 透明度变量 ===== */
:root
  --opacity-0: 0
  --opacity-5: 0.05
  --opacity-10: 0.1
  --opacity-20: 0.2
  --opacity-25: 0.25
  --opacity-30: 0.3
  --opacity-40: 0.4
  --opacity-45: 0.45
  --opacity-50: 0.5
  --opacity-55: 0.55
  --opacity-60: 0.6
  --opacity-70: 0.7
  --opacity-75: 0.75
  --opacity-80: 0.8
  --opacity-85: 0.85
  --opacity-90: 0.9
  --opacity-95: 0.95
  --opacity-100: 1

/* ===== 模糊效果变量 ===== */
:root
  --blur-sm: 4px
  --blur-md: 8px
  --blur-lg: 12px
  --blur-xl: 16px
  --blur-2xl: 20px
  --blur-3xl: 24px

/* ===== 变换变量 ===== */
:root
  /* 平移 */
  --translate-xs: 0.125rem   /* 2px */
  --translate-sm: 0.25rem     /* 4px */
  --translate-md: 0.5rem      /* 8px */
  --translate-lg: 0.75rem     /* 12px */
  --translate-xl: 1rem        /* 16px */
  --translate-2xl: 1.5rem      /* 24px */
  --translate-3xl: 2rem       /* 32px */
  
  /* 缩放 */
  --scale-95: 0.95
  --scale-98: 0.98
  --scale-100: 1
  --scale-105: 1.05
  --scale-110: 1.1

/* ===== 层级变量 ===== */
:root
  --z-dropdown: 1000
  --z-sticky: 1020
  --z-fixed: 1030
  --z-modal-backdrop: 1040
  --z-modal: 1050
  --z-popover: 1060
  --z-tooltip: 1070
  --z-toast: 1080
  --z-navbar: 20
  --z-banner: 10
  --z-content: 30

/* ===== 性能优化变量 ===== */
:root
  /* GPU加速 */
  --gpu-transform: translateZ(0)
  --gpu-backface: hidden
  
  /* 动画性能 */
  --animation-fill-mode: both
  --animation-timing: var(--ease-standard)
  --animation-duration: var(--duration-medium)

/* ===== 响应式工具类 ===== */
@media (max-width: 767px)
  :root
    --container-width: var(--container-sm)
    --widget-gap: var(--widget-gap-mobile)

@media (min-width: 768px) and (max-width: 1279px)
  :root
    --container-width: var(--container-md)
    --widget-gap: var(--widget-gap-tablet)

@media (min-width: 1280px)
  :root
    --container-width: var(--container-lg)
    --widget-gap: var(--widget-gap-desktop)
