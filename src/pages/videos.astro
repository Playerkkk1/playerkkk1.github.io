---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { formatDateI18n } from "@/utils/date-utils";
import { safeMediaUrl } from "@/utils/media-url";
import "@/styles/pages/common.css";

const videos = (await getCollection("videos", ({ data }) => !data.draft))
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
---

<MainGridLayout title="视频" description="记录与分享值得观看的影像。">
	<section class="page-shell" aria-labelledby="video-page-title">
		<header class="page-header card-base">
			<div class="page-heading">
				<div class="page-icon" aria-hidden="true"><Icon name="material-symbols:play-circle-rounded" /></div>
				<div><h1 id="video-page-title">视频</h1><p>记录与分享值得观看的影像。</p></div>
			</div>
			<div class="page-count"><strong>{videos.length}</strong><span>个视频</span></div>
		</header>
		{videos.length === 0 && <p class="card-base p-6 text-75">还没有发布视频。</p>}
		<div class="video-list">
			{videos.map(({ id, data }) => {
				const directVideo = /\.(mp4|webm|ogv)$/i.test(new URL(data.url).pathname);
				const cover = safeMediaUrl(data.cover);
				return (
					<article class="card-base p-4 md:p-6" id={`video-${id}`}>
						{directVideo ? (
							<managed-video-status>
							<video class="video-media mb-4" data-managed-video controls playsinline preload="none" poster={cover || undefined} aria-label={data.title}>
								<source src={data.url} />
								<a href={data.url} target="_blank" rel="noopener noreferrer">打开视频</a>
							</video>
							<p class="text-sm text-75 mb-4" data-video-error role="status" hidden>视频加载失败，请使用下方「打开原视频」在源站观看。</p>
							</managed-video-status>
						) : cover && (
							<a href={data.url} target="_blank" rel="noopener noreferrer" class="block mb-4" aria-label={`观看：${data.title}`}>
								<ImageWrapper src={cover} alt={data.title} class="video-media" width={960} />
							</a>
						)}
						<h2 class="text-xl font-bold text-90 break-words">{data.title}</h2>
						<time class="text-sm text-75" datetime={data.published.toISOString()}>{formatDateI18n(data.published, true)}</time>
						{data.description && <p class="mt-3 text-75 whitespace-pre-line break-words">{data.description}</p>}
						<a class="btn-regular inline-flex items-center gap-2 rounded-lg px-3 py-2 mt-4" href={data.url} target="_blank" rel="noopener noreferrer">
							<Icon name="material-symbols:open-in-new-rounded" />{directVideo ? "打开原视频" : "前往观看"}
						</a>
					</article>
				);
			})}
		</div>
	</section>

<script>
	// 自定义元素在首次打开与 Swup 换页后都会重新连接；移除时解绑事件。
	class ManagedVideoStatus extends HTMLElement {
		private video: HTMLVideoElement | null = null;
		private status: HTMLElement | null = null;
		private showError = () => { if (this.status) this.status.hidden = false; };
		private clearError = () => { if (this.status) this.status.hidden = true; };
		connectedCallback() {
			this.video = this.querySelector("video");
			this.status = this.querySelector("[data-video-error]");
			this.video?.addEventListener("error", this.showError);
			this.video?.querySelector("source")?.addEventListener("error", this.showError);
			this.video?.addEventListener("loadeddata", this.clearError);
		}
		disconnectedCallback() {
			this.video?.removeEventListener("error", this.showError);
			this.video?.querySelector("source")?.removeEventListener("error", this.showError);
			this.video?.removeEventListener("loadeddata", this.clearError);
		}
	}
	if (!customElements.get("managed-video-status")) customElements.define("managed-video-status", ManagedVideoStatus);
</script>
</MainGridLayout>

<style>
	.video-list { display: grid; gap: 1rem; min-width: 0; }
	.video-list article { min-width: 0; }
	.video-media { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 0.75rem; background: var(--page-bg); }
</style>
