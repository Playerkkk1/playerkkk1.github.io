---
import { Icon } from "astro-icon/components";
import { pageViewConfig } from "@/config/pageViewConfig";
import { siteConfig } from "@/config/siteConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getPostUrlBySlug } from "@/utils/url-utils";

interface Props {
	id: string;
}

const { id } = Astro.props;
---

<div class="flex items-center" data-pagefind-ignore>
  <div class="meta-icon">
    <Icon name="material-symbols:visibility-outline-rounded" class="text-xl" />
  </div>
  <span class="text-50 text-sm font-medium mr-1">{i18n(I18nKey.pageViews)}</span>
  <span
    class="text-50 text-sm font-medium"
    data-page-view-count
    data-page-path={getPostUrlBySlug(id)}
    data-site-origin={new URL(siteConfig.site_url).origin}
    data-endpoint={pageViewConfig.endpoint}
    data-timeout={pageViewConfig.timeout}
    data-loading={i18n(I18nKey.pageViewsLoading)}
    data-error={i18n(I18nKey.pageViewsError)}
    aria-live="polite"
  >{i18n(I18nKey.pageViewsLoading)}</span>
</div>
