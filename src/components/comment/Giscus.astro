---
import { commentConfig } from "@/config/commentConfig";
import { resolveGiscusPath } from "@/utils/giscus-runtime";

interface Props {
	path: string;
}

const giscus = commentConfig.giscus;
const configured = Boolean(giscus?.repoId && giscus?.categoryId);
const path = resolveGiscusPath(Astro.props.path, Astro.url.toString());
const discussionsUrl = `https://github.com/${giscus?.repo}/discussions`;
---

{configured && giscus ? (
  <div>
    <giscus-widget
      id="comments"
      class="block w-full"
      data-thread-path={Astro.props.path}
      repo={giscus.repo}
      repoid={giscus.repoId}
      category={giscus.category}
      categoryid={giscus.categoryId}
      mapping="specific"
      term={path}
      strict={giscus.strict}
      reactionsenabled={giscus.reactionsEnabled}
      emitmetadata={giscus.emitMetadata}
      inputposition={giscus.inputPosition}
      theme="light"
      lang={giscus.lang}
      loading={giscus.loading}
    />
    <p hidden data-giscus-error class="mt-3 text-sm text-(--content-meta)">留言组件暂时加载失败，请刷新后重试。</p>
    <p class="mt-4 text-sm text-(--content-meta)">
      使用 GitHub 登录即可留言，内容公开展示。也可以<a href={discussionsUrl} target="_blank" rel="noopener noreferrer" class="link text-(--primary)">前往 GitHub 讨论区</a>查看和交流。
    </p>
  </div>
) : (
  <p class="text-sm text-(--content-meta)">留言区正在准备中，请稍后再来。</p>
)}
